# Local development server (all state is in-memory; no AWS access is used).
# Port for `npm run dev`. Use 0 for an ephemeral port (worktree-safe).
PORT=3000
# Bearer token seeded into the local fake client store at startup.
LOCAL_DEV_TOKEN=local-dev-token

# Deployed Lambda configuration (set by CDK, listed here for reference only).
# TABLE_NAME=            DynamoDB table for builds/deployments/clients
# ARTIFACT_BUCKET=       S3 bucket for build packages
# LOG_LEVEL=info
